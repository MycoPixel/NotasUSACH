# npm 12+ bloquea por defecto instalar paquetes desde una URL remota
# (allow-remote=none), y por eso "xlsx" (ver README, sección sobre esta
# dependencia) falla con EALLOWREMOTE. "root" sólo permite esto para
# dependencias declaradas directamente en package.json (como xlsx aquí),
# no para cualquier paquete transitivo — más seguro que "all".
allow-remote=root
